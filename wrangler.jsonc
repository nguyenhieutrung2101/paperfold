// Cloudflare Workers deploy config: the app is a static site (the kernel runs in a
// browser Web Worker, not on Cloudflare). `pnpm build` writes apps/web/dist; the deploy
// command `npx wrangler deploy` uploads it from here, at the workspace root.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "paperfold",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
