{
  "name": "paperfold",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @paperfold/web dev",
    "build": "pnpm --filter @paperfold/web build",
    "preview": "pnpm --filter @paperfold/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "e2e": "pnpm --filter @paperfold/web e2e",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
